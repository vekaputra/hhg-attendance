# Copy to .env (git-ignored) next to docker-compose.yml and fill in.
# Optional: the business timezone, Asia/Jakarta when unset.
# TIMEZONE=Asia/Jakarta
# MySQL on local-db-network; the database must be utf8mb4 / utf8mb4_bin (see DEPLOY.md).
ATTENDANCE_DSN=hhg:password@tcp(mysql:3306)/hhg?charset=utf8mb4&collation=utf8mb4_bin
# Basic-auth login the Pi relay uses for POST /api/events; the endpoint refuses every request while either is empty.
# Must match RELAY_USER and RELAY_PASSWORD in the Pi's /etc/hhg-relay.env. Password: openssl rand -base64 24
RELAY_USER=
RELAY_PASSWORD=
