# Copy to .env (git-ignored) next to docker-compose.yml and fill in.
TIMEZONE=Asia/Jakarta
# The VPS public IP the devices send events to (Oracle instances are behind NAT).
ALARM_IP=
# MySQL on local-db-network; the database must be utf8mb4 / utf8mb4_bin (see DEPLOY.md).
ATTENDANCE_DSN=hhg:password@tcp(mysql:3306)/hhg?charset=utf8mb4&collation=utf8mb4_bin
